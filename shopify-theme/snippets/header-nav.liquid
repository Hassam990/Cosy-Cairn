<header class="site-header">
  <div class="container">
    <div class="header-inner">

      <!-- Logo -->
      <a href="{{ routes.root_url }}" class="logo">
        {%- if settings.logo -%}
          <img class="logo-img" src="{{ settings.logo | image_url: width: 120 }}" alt="{{ shop.name }}" width="60" height="60">
        {%- else -%}
          <div class="logo-img logo-placeholder">{{ shop.name | slice: 0, 2 | upcase }}</div>
        {%- endif -%}
        <div class="logo-text">
          <span class="brand">{{ shop.name }}</span>
          <span class="tagline">{{ settings.store_tagline | default: 'For homes full of light & wonder' }}</span>
        </div>
      </a>

      <!-- Nav -->
      <nav class="main-nav" id="main-nav" aria-label="Main navigation">
        <div class="nav-drawer-header">
          <span class="nav-drawer-brand">{{ shop.name }}</span>
          <button class="nav-close-btn" id="nav-close-btn" aria-label="Close menu">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>

        <ul>
          {%- assign menu_links = linklists['main-menu'].links -%}
          {%- if menu_links.size > 0 -%}
            {%- for link in menu_links -%}
              <li class="{% if link.child_links.size > 0 %}nav-dropdown{% endif %}">
                <a href="{{ link.url }}" {% if link.active %}class="active"{% endif %}>{{ link.title }}</a>
                {%- if link.child_links.size > 0 -%}
                  <ul class="dropdown-menu">
                    {%- for child in link.child_links -%}
                      <li><a href="{{ child.url }}">{{ child.title }}</a></li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </li>
            {%- endfor -%}
          {%- else -%}
            <!-- Hardcoded fallback nav — always shows even without a menu created -->
            <li><a href="{{ routes.root_url }}" {% if template.name == 'index' %}class="active"{% endif %}>Home</a></li>
            <li class="nav-dropdown">
              <a href="{{ routes.all_products_collection_url }}" {% if template.name == 'collection' %}class="active"{% endif %}>Shop</a>
              <ul class="dropdown-menu">
                <li><a href="/collections/home-decor">Home Decor</a></li>
                <li><a href="/collections/candles">Candles</a></li>
                <li><a href="/collections/kitchen-dining">Kitchen &amp; Dining</a></li>
                <li><a href="/collections/textiles">Textiles</a></li>
                <li><a href="/collections/gifts">Gifts</a></li>
              </ul>
            </li>
            <li><a href="/collections/new-in" {% if request.path == '/collections/new-in' %}class="active"{% endif %}>New In</a></li>
            <li><a href="/collections" {% if template.name == 'list-collections' %}class="active"{% endif %}>Collections</a></li>
            <li><a href="/pages/about" {% if request.path contains 'about' %}class="active"{% endif %}>About</a></li>
            <li><a href="/pages/contact" {% if request.path contains 'contact' %}class="active"{% endif %}>Contact</a></li>
          {%- endif -%}
        </ul>

        <div class="nav-drawer-footer">
          <p class="nav-drawer-tagline">{{ settings.store_tagline | default: 'For homes full of light & wonder' }}</p>
          <div class="nav-drawer-social">
            <a href="{{ settings.social_instagram | default: '#' }}" aria-label="Instagram">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
            </a>
            <a href="{{ settings.social_pinterest | default: '#' }}" aria-label="Pinterest">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M8 12c0-2.76 1.79-5 4-5s4 2.24 4 5c0 2.76-1.79 5-4 5"/></svg>
            </a>
            <a href="{{ settings.social_facebook | default: '#' }}" aria-label="Facebook">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>
            </a>
          </div>
        </div>
      </nav>

      <!-- Icons -->
      <div class="header-icons">
        <a href="{{ routes.search_url }}" class="icon-btn" aria-label="Search">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        </a>
        <a href="{{ routes.account_url }}" class="icon-btn" aria-label="Account">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
        </a>
        <button class="icon-btn" id="cart-open-btn" aria-label="Cart">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
          <span class="cart-count" id="cart-count" {% if cart.item_count == 0 %}style="display:none"{% endif %}>{{ cart.item_count }}</span>
        </button>
        <button class="mobile-menu-toggle" id="mobile-menu-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="main-nav">
          <span class="hamburger-box" aria-hidden="true">
            <span class="hamburger-bar top"></span>
            <span class="hamburger-bar mid"></span>
            <span class="hamburger-bar bot"></span>
          </span>
        </button>
      </div>

    </div>
  </div>
</header>
<div class="mobile-menu-overlay" id="mobile-menu-overlay"></div>
