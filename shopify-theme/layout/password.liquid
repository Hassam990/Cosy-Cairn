<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ shop.name }} — Coming Soon</title>
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Playfair+Display:ital,wght@0,700;0,800;0,900;1,700;1,800&display=swap" rel="stylesheet">
  <style>
    body { margin:0; padding:0; background:var(--cream); display:flex; align-items:center; justify-content:center; min-height:100vh; text-align:center; font-family:'Cormorant Garamond',Georgia,serif; }
    .password-page { max-width:520px; padding:48px 32px; }
    .password-logo { width:80px; height:80px; border-radius:50%; background:var(--sage-light); display:flex; align-items:center; justify-content:center; margin:0 auto 24px; font-size:1.8rem; font-weight:700; color:var(--white); }
    .password-title { font-family:'Playfair Display',Georgia,serif; font-size:clamp(2rem,5vw,3rem); font-weight:800; color:var(--text-dark); margin-bottom:12px; }
    .password-subtitle { font-size:1.1rem; font-style:italic; color:var(--text-light); margin-bottom:36px; line-height:1.6; }
    .password-form { display:flex; gap:0; background:var(--white); border:1.5px solid var(--beige); border-radius:40px; padding:6px 6px 6px 20px; }
    .password-form input { flex:1; border:none; background:transparent; font-family:inherit; font-size:1rem; color:var(--text-dark); outline:none; padding:10px 0; }
    .password-form input::placeholder { color:var(--text-light); }
    .password-form button { background:var(--sage); color:var(--white); border:none; padding:10px 24px; border-radius:30px; font-family:inherit; font-size:0.82rem; font-weight:600; letter-spacing:1.5px; text-transform:uppercase; cursor:pointer; }
    .password-form button:hover { background:var(--sage-dark); }
    .password-note { margin-top:16px; font-size:0.82rem; color:var(--text-light); font-style:italic; }
  </style>
</head>
<body>
  <div class="password-page">
    <div class="password-logo">CC</div>
    <h1 class="password-title">The Cosy Cairn</h1>
    <p class="password-subtitle">Something beautiful is on its way.<br>Enter the password to peek inside.</p>
    {%- form 'storefront_password' -%}
      <div class="password-form">
        <input type="password" name="password" placeholder="Enter password" autocomplete="current-password">
        <button type="submit">Enter</button>
      </div>
      {%- if form.errors -%}
        <p style="color:#c0786a;margin-top:12px;font-size:0.9rem;">{{ form.errors | default_errors }}</p>
      {%- endif -%}
    {%- endform -%}
    <p class="password-note">Powered by The Cosy Cairn</p>
  </div>
</body>
</html>
