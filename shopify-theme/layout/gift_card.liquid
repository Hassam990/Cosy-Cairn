<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Your {{ gift_card.initial_value | money }} Gift Card for {{ shop.name }}</title>
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400&family=Playfair+Display:ital,wght@0,700;0,800&display=swap" rel="stylesheet">
</head>
<body style="background:var(--cream);font-family:'Cormorant Garamond',Georgia,serif;padding:48px 24px;text-align:center;">
  <h1 style="font-family:'Playfair Display',Georgia,serif;font-size:2rem;margin-bottom:8px;">{{ shop.name }}</h1>
  <p style="font-style:italic;color:var(--text-light);margin-bottom:32px;">Gift Card</p>
  <div style="background:var(--white);max-width:480px;margin:0 auto;border-radius:16px;padding:40px;box-shadow:0 8px 30px rgba(61,61,53,0.1);">
    <p style="font-size:2.5rem;font-weight:700;color:var(--sage-dark);margin-bottom:8px;">{{ gift_card.initial_value | money }}</p>
    <p style="color:var(--text-light);margin-bottom:24px;">Balance: {{ gift_card.balance | money }}</p>
    <p style="font-size:0.85rem;letter-spacing:3px;text-transform:uppercase;margin-bottom:8px;color:var(--text-medium);">Gift Card Code</p>
    <p style="font-size:1.4rem;font-weight:600;letter-spacing:4px;color:var(--text-dark);padding:16px;background:var(--cream-warm);border-radius:8px;border:1px solid var(--beige);">{{ gift_card.code | format_code }}</p>
    {%- if gift_card.expired -%}
      <p style="color:#c0786a;margin-top:16px;font-size:0.9rem;">This gift card has expired.</p>
    {%- endif -%}
  </div>
</body>
</html>
