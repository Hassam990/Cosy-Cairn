<section class="page-header">
  <div class="container">
    <h1>{{ section.settings.title }}</h1>
    <p>{{ section.settings.subtitle }}</p>
  </div>
</section>

<section class="section" style="padding-top:48px;">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">{{ section.settings.grid_title }}</h2>
      <p class="section-subtitle">{{ section.settings.grid_subtitle }}</p>
      <div class="section-divider"></div>
    </div>

    {%- assign new_col = collections[section.settings.collection] -%}
    {%- assign new_products = '' -%}

    {%- comment -%}Try dedicated new-in collection first, then fall back to new-tagged products{%- endcomment -%}
    {%- if new_col != blank and new_col.products.size > 0 -%}
      <div class="product-grid">
        {%- for product in new_col.products limit: 8 -%}
          {%- render 'product-card', product: product -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      {%- assign tagged_count = 0 -%}
      {%- for product in collections.all.products -%}
        {%- if product.tags contains 'new' or product.tags contains 'new-in' -%}
          {%- assign tagged_count = tagged_count | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}

      {%- if tagged_count > 0 -%}
        <div class="product-grid">
          {%- for product in collections.all.products -%}
            {%- if product.tags contains 'new' or product.tags contains 'new-in' -%}
              {%- render 'product-card', product: product -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="empty-state">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1"><path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>
          <h3>New arrivals coming soon</h3>
          <p>Tag products with <strong>new</strong> or <strong>new-in</strong> after importing your CSV and they'll appear here automatically.</p>
          <a href="{{ routes.all_products_collection_url }}" class="btn btn-primary">Browse All Products</a>
        </div>
      {%- endif -%}
    {%- endif -%}

    {%- if new_col.products.size > 0 or tagged_count > 0 -%}
      <div class="section-cta">
        <a href="{{ routes.all_products_collection_url }}" class="btn btn-outline">View All Products</a>
      </div>
    {%- endif -%}
  </div>
</section>

<!-- Featured Banner -->
<section class="featured-banner">
  <div class="container">
    <div class="featured-banner-inner">
      <div class="featured-banner-content">
        <span class="banner-label">{{ section.settings.banner_label }}</span>
        <h2>{{ section.settings.banner_heading }}<br><em>{{ section.settings.banner_heading2 }}</em></h2>
        <p>{{ section.settings.banner_text }}</p>
        <a href="{{ section.settings.banner_cta_url | default: routes.all_products_collection_url }}" class="btn btn-primary">
          {{ section.settings.banner_cta }}
        </a>
      </div>
      <div class="featured-banner-image">
        {%- if section.settings.banner_image -%}
          <img src="{{ section.settings.banner_image | image_url: width: 800 }}"
               alt="{{ section.settings.banner_heading | escape }}" loading="lazy">
        {%- else -%}
          <div class="featured-banner-placeholder">
            <div class="featured-banner-placeholder-inner">
              <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="none" viewBox="0 0 24 24" stroke="rgba(122,143,106,0.4)" stroke-width="0.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
              <p style="color:var(--text-light);font-style:italic;font-size:0.85rem;margin-top:12px;">Upload an image in Theme Editor</p>
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<!-- Newsletter -->
<section class="newsletter">
  <div class="container">
    <div class="newsletter-icon">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
    </div>
    <h2>{{ section.settings.nl_title }}</h2>
    <p>{{ section.settings.nl_text }}</p>
    {%- form 'customer', id: 'new-in-newsletter' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="newsletter-form">
        <input type="email" name="contact[email]" placeholder="{{ section.settings.nl_placeholder }}" required aria-label="Email"
               style="color:#3d3d35 !important;-webkit-text-fill-color:#3d3d35 !important;background:transparent;border:none;outline:none;flex:1;padding:12px 8px;font-family:inherit;font-size:1rem;">
        <button type="submit" class="btn btn-light">{{ section.settings.nl_btn }}</button>
      </div>
    {%- endform -%}
    <p class="newsletter-note">No spam, ever. Unsubscribe any time.</p>
  </div>
</section>

{% schema %}
{
  "name": "New In",
  "settings": [
    { "type": "text",         "id": "title",          "label": "Page title",       "default": "New In" },
    { "type": "text",         "id": "subtitle",       "label": "Page subtitle",    "default": "Fresh arrivals to make your home feel even more special" },
    { "type": "text",         "id": "grid_title",     "label": "Grid title",       "default": "Just Landed" },
    { "type": "text",         "id": "grid_subtitle",  "label": "Grid subtitle",    "default": "The newest pieces added to our cosy collection" },
    { "type": "collection",   "id": "collection",     "label": "New In collection","info": "Or tag products with 'new-in' and they auto-appear" },
    { "type": "text",         "id": "banner_label",   "label": "Banner label",     "default": "Just Arrived" },
    { "type": "text",         "id": "banner_heading", "label": "Banner heading",   "default": "Beautiful New" },
    { "type": "text",         "id": "banner_heading2","label": "Banner heading 2", "default": "Arrivals" },
    { "type": "textarea",     "id": "banner_text",    "label": "Banner text",      "default": "From healing crystals and hand-poured candles to spiritual gifts and cosy home accessories — thoughtfully chosen for homes full of light and wonder." },
    { "type": "text",         "id": "banner_cta",     "label": "Banner button",    "default": "Shop All New In" },
    { "type": "url",          "id": "banner_cta_url", "label": "Banner button URL" },
    { "type": "image_picker", "id": "banner_image",   "label": "Banner image" },
    { "type": "text",         "id": "nl_title",       "label": "Newsletter title", "default": "Never Miss a New Arrival" },
    { "type": "text",         "id": "nl_text",        "label": "Newsletter text",  "default": "Subscribe to be the first to see our latest cosy finds." },
    { "type": "text",         "id": "nl_placeholder", "label": "Email placeholder","default": "Your email address" },
    { "type": "text",         "id": "nl_btn",         "label": "Subscribe button", "default": "Subscribe" }
  ],
  "presets": [{ "name": "New In" }]
}
{% endschema %}
