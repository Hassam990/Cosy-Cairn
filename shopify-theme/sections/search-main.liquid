<div class="page-header">
  <div class="container">
    <h1>Search</h1>
    <form action="{{ routes.search_url }}" method="get" style="max-width:520px;margin:24px auto 0;display:flex;background:var(--white);border:1.5px solid var(--beige);border-radius:40px;padding:4px 4px 4px 20px;">
      <input type="hidden" name="type" value="product">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search our store…" style="flex:1;border:none;background:transparent;font-family:inherit;font-size:1rem;outline:none;color:var(--text-dark);">
      <button type="submit" class="btn btn-primary" style="padding:10px 24px;">Search</button>
    </form>
  </div>
</div>

<div class="container" style="padding-top:48px;padding-bottom:80px;">
  {%- if search.performed -%}
    {%- if search.results_count == 0 -%}
      <p style="text-align:center;font-style:italic;color:var(--text-light);padding:64px 0;font-size:1.1rem;">No results for "{{ search.terms }}"</p>
    {%- else -%}
      <p style="margin-bottom:32px;color:var(--text-light);">{{ search.results_count }} result{% if search.results_count != 1 %}s{% endif %} for "{{ search.terms }}"</p>
      <div class="collection-grid">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}
            {%- render 'product-card', product: item -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Search",
  "settings": []
}
{% endschema %}
