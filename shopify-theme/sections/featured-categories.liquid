<section class="section">
  <div class="container">
    <div class="section-header fade-in">
      <h2 class="section-title">{{ section.settings.title }}</h2>
      <p class="section-subtitle">{{ section.settings.subtitle }}</p>
      <div class="section-divider"></div>
    </div>
    <div class="category-grid">
      {%- for collection in collections limit: 5 -%}
        <a href="{{ collection.url }}" class="category-card fade-in">
          <div class="category-card-image">
            {%- if collection.image -%}
              <img src="{{ collection.image | image_url: width: 600 }}"
                   alt="{{ collection.title }}"
                   loading="lazy" width="600" height="700">
            {%- else -%}
              <div class="category-card-placeholder">{{ collection.title | slice: 0, 2 | upcase }}</div>
            {%- endif -%}
          </div>
          <div class="category-card-overlay">
            <h3 class="category-card-title">{{ collection.title }}</h3>
            {%- if collection.description != blank -%}
              <p class="category-card-desc">{{ collection.description | strip_html | truncate: 60 }}</p>
            {%- endif -%}
            <span class="category-card-link">Shop Now</span>
          </div>
        </a>
      {%- else -%}
        {%- for i in (1..5) -%}
          <div class="category-card category-card--empty fade-in">
            <div class="category-card-image">
              <div class="category-card-placeholder">—</div>
            </div>
            <div class="category-card-overlay">
              <h3 class="category-card-title">Collection {{ i }}</h3>
              <span class="category-card-link">Shop Now</span>
            </div>
          </div>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Categories",
  "settings": [
    { "type": "text", "id": "title",    "label": "Section title",    "default": "Shop by Category" },
    { "type": "text", "id": "subtitle", "label": "Section subtitle", "default": "Curated collections for every cosy corner" }
  ],
  "presets": [{ "name": "Featured Categories" }]
}
{% endschema %}
