<section class="section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">{{ section.settings.title }}</h2>
      <p class="section-subtitle">{{ section.settings.subtitle }}</p>
      <div class="section-divider"></div>
    </div>

    <div class="category-grid">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- assign col = collections[block.settings.collection] -%}
          {%- if col != blank -%}
            <a href="{{ col.url }}" class="category-card" {{ block.shopify_attributes }}>
              <div class="category-card-image">
                {%- if col.image -%}
                  <img src="{{ col.image | image_url: width: 600 }}" alt="{{ col.title | escape }}" loading="lazy" width="600" height="700">
                {%- elsif col.products.first.featured_image -%}
                  <img src="{{ col.products.first.featured_image | image_url: width: 600 }}" alt="{{ col.title | escape }}" loading="lazy" width="600" height="700">
                {%- else -%}
                  <div class="category-card-placeholder">{{ col.title | slice: 0, 2 | upcase }}</div>
                {%- endif -%}
              </div>
              <div class="category-card-overlay">
                <h3 class="category-card-title">{{ col.title }}</h3>
                {%- if col.description != blank -%}
                  <p class="category-card-desc">{{ col.description | strip_html | truncate: 55 }}</p>
                {%- endif -%}
                <span class="category-card-link">Shop Now</span>
              </div>
            </a>
          {%- else -%}
            {%- comment -%}Block exists but no collection assigned — show prompt in editor only{%- endcomment -%}
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- comment -%}No blocks — auto-show first 5 real collections from the store{%- endcomment -%}
        {%- assign shown = 0 -%}
        {%- for col in collections -%}
          {%- unless col.handle == 'frontpage' or col.handle == 'all' -%}
            {%- if shown < 5 -%}
              <a href="{{ col.url }}" class="category-card">
                <div class="category-card-image">
                  {%- if col.image -%}
                    <img src="{{ col.image | image_url: width: 600 }}" alt="{{ col.title | escape }}" loading="lazy">
                  {%- elsif col.products.first.featured_image -%}
                    <img src="{{ col.products.first.featured_image | image_url: width: 600 }}" alt="{{ col.title | escape }}" loading="lazy">
                  {%- else -%}
                    <div class="category-card-placeholder">{{ col.title | slice: 0, 2 | upcase }}</div>
                  {%- endif -%}
                </div>
                <div class="category-card-overlay">
                  <h3 class="category-card-title">{{ col.title }}</h3>
                  {%- if col.description != blank -%}
                    <p class="category-card-desc">{{ col.description | strip_html | truncate: 55 }}</p>
                  {%- endif -%}
                  <span class="category-card-link">Shop Now</span>
                </div>
              </a>
              {%- assign shown = shown | plus: 1 -%}
            {%- endif -%}
          {%- endunless -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Categories",
  "max_blocks": 5,
  "settings": [
    { "type": "text", "id": "title",    "label": "Title",    "default": "Shop by Category" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Curated collections for every cosy corner" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" }
      ]
    }
  ],
  "presets": [{
    "name": "Featured Categories",
    "blocks": [
      { "type": "category" },
      { "type": "category" },
      { "type": "category" },
      { "type": "category" },
      { "type": "category" }
    ]
  }]
}
{% endschema %}
