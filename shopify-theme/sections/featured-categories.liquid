<section class="section">
  <div class="container">
    <div class="section-header fade-in">
      <h2 class="section-title">{{ section.settings.title }}</h2>
      <p class="section-subtitle">{{ section.settings.subtitle }}</p>
      <div class="section-divider"></div>
    </div>

    <div class="category-grid">
      {%- for block in section.blocks -%}
        {%- assign col = collections[block.settings.collection] -%}
        {%- if col != blank -%}
          <a href="{{ col.url }}" class="category-card fade-in" {{ block.shopify_attributes }}>
            <div class="category-card-image">
              {%- if col.image -%}
                <img src="{{ col.image | image_url: width: 600 }}"
                     alt="{{ col.title | escape }}"
                     loading="lazy" width="600" height="700">
              {%- elsif col.products.first.featured_image -%}
                <img src="{{ col.products.first.featured_image | image_url: width: 600 }}"
                     alt="{{ col.title | escape }}"
                     loading="lazy" width="600" height="700">
              {%- else -%}
                <div class="category-card-placeholder">{{ col.title | slice: 0, 2 | upcase }}</div>
              {%- endif -%}
            </div>
            <div class="category-card-overlay">
              <h3 class="category-card-title">{{ col.title }}</h3>
              {%- if col.description != blank -%}
                <p class="category-card-desc">{{ col.description | strip_html | truncate: 60 }}</p>
              {%- endif -%}
              <span class="category-card-link">Shop Now</span>
            </div>
          </a>
        {%- else -%}
          <!-- block has no collection selected — skip -->
        {%- endif -%}
      {%- else -%}
        {%- comment -%}No blocks added — show placeholder cards{%- endcomment -%}
        {%- for i in (1..5) -%}
          <div class="category-card category-card--empty fade-in">
            <div class="category-card-image">
              <div class="category-card-placeholder">—</div>
            </div>
            <div class="category-card-overlay">
              <h3 class="category-card-title">Add a collection</h3>
              <span class="category-card-link">Edit section</span>
            </div>
          </div>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Categories",
  "max_blocks": 5,
  "settings": [
    { "type": "text", "id": "title",    "label": "Section title",    "default": "Shop by Category" },
    { "type": "text", "id": "subtitle", "label": "Section subtitle", "default": "Curated collections for every cosy corner" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Categories",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
