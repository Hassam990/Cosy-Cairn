<section class="section">
  <div class="container">
    <div class="section-header fade-in">
      <h2 class="section-title">{{ section.settings.title }}</h2>
      <p class="section-subtitle">{{ section.settings.subtitle }}</p>
      <div class="section-divider"></div>
    </div>

    <div class="category-grid">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- assign col = collections[block.settings.collection] -%}
          <a href="{{ col.url | default: '/collections/all' }}" class="category-card fade-in" {{ block.shopify_attributes }}>
            <div class="category-card-image">
              {%- if col != blank and col.image -%}
                <img src="{{ col.image | image_url: width: 600 }}"
                     alt="{{ col.title | escape }}"
                     loading="lazy" width="600" height="700">
              {%- elsif col != blank and col.products.first.featured_image -%}
                <img src="{{ col.products.first.featured_image | image_url: width: 600 }}"
                     alt="{{ col.title | escape }}"
                     loading="lazy" width="600" height="700">
              {%- else -%}
                <div class="category-card-placeholder">
                  {{ col.title | default: 'Shop' | slice: 0, 2 | upcase }}
                </div>
              {%- endif -%}
            </div>
            <div class="category-card-overlay">
              <h3 class="category-card-title">{{ col.title | default: block.settings.collection | replace: '-', ' ' | capitalize }}</h3>
              <span class="category-card-link">Shop Now</span>
            </div>
          </a>
        {%- endfor -%}
      {%- else -%}
        {%- assign placeholder_names = 'Home Decor,Candles,Kitchen & Dining,Textiles,Gifts' | split: ',' -%}
        {%- for name in placeholder_names -%}
          <div class="category-card fade-in">
            <div class="category-card-image">
              <div class="category-card-placeholder">{{ name | slice: 0, 2 | upcase }}</div>
            </div>
            <div class="category-card-overlay">
              <h3 class="category-card-title">{{ name }}</h3>
              <span class="category-card-link">Shop Now</span>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Categories",
  "max_blocks": 5,
  "settings": [
    { "type": "text", "id": "title",    "label": "Section title",    "default": "Shop by Category" },
    { "type": "text", "id": "subtitle", "label": "Section subtitle", "default": "Curated collections for every cosy corner" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Categories",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
