<section class="hero">
  {%- if section.settings.image -%}
    <div class="hero-bg" style="background-image: url('{{ section.settings.image | image_url: width: 1920 }}');"></div>
  {%- else -%}
    <div class="hero-bg hero-bg--placeholder"></div>
  {%- endif -%}
  <div class="hero-overlay"></div>

  <div class="hero-content fade-in">
    {%- if section.settings.eyebrow != blank -%}
      <div class="hero-eyebrow">
        <span class="hero-eyebrow-line"></span>
        <span class="hero-eyebrow-text">{{ section.settings.eyebrow }}</span>
        <span class="hero-eyebrow-line"></span>
      </div>
    {%- endif -%}

    <h1 class="hero-title">
      {{ section.settings.heading_line1 }}<br>
      <em>{{ section.settings.heading_line2 }}</em>
    </h1>

    <div class="hero-ornament">
      <span></span>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 2C6.477 2 2 6.477 2 12s4.477 10 10 10 10-4.477 10-10S17.523 2 12 2zm0 4a1 1 0 110 2 1 1 0 010-2zm0 3a1 1 0 011 1v5a1 1 0 11-2 0V10a1 1 0 011-1z"/>
      </svg>
      <span></span>
    </div>

    {%- if section.settings.tagline != blank -%}
      <p class="hero-tagline">{{ section.settings.tagline }}</p>
    {%- endif -%}

    <div class="hero-actions">
      {%- if section.settings.cta1_label != blank -%}
        <a href="{{ section.settings.cta1_url }}" class="btn btn-hero-primary">
          {{ section.settings.cta1_label }}
        </a>
      {%- endif -%}
      {%- if section.settings.cta2_label != blank -%}
        <a href="{{ section.settings.cta2_url }}" class="btn btn-hero-outline">
          {{ section.settings.cta2_label }}
        </a>
      {%- endif -%}
    </div>

    <p class="hero-scroll-hint">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
      </svg>
      Scroll to discover
    </p>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image",         "label": "Hero background image" },
    { "type": "text",         "id": "eyebrow",        "label": "Eyebrow text",     "default": "Welcome to" },
    { "type": "text",         "id": "heading_line1",  "label": "Heading line 1",   "default": "The Cosy" },
    { "type": "text",         "id": "heading_line2",  "label": "Heading line 2 (italic)", "default": "Cairn" },
    { "type": "textarea",     "id": "tagline",        "label": "Tagline",          "default": "Beautiful little finds for homes full of light and a little wonder" },
    { "type": "text",         "id": "cta1_label",     "label": "Button 1 label",   "default": "Shop Now" },
    { "type": "url",          "id": "cta1_url",       "label": "Button 1 URL",     "default": "/collections/all" },
    { "type": "text",         "id": "cta2_label",     "label": "Button 2 label",   "default": "Explore Collections" },
    { "type": "url",          "id": "cta2_url",       "label": "Button 2 URL",     "default": "/collections" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
