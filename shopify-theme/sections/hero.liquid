<section class="hero">

  {%- if section.settings.image -%}
    <img
      class="hero-bg-img"
      src="{{ section.settings.image | image_url: width: 1920 }}"
      srcset="{{ section.settings.image | image_url: width: 800 }} 800w,
              {{ section.settings.image | image_url: width: 1200 }} 1200w,
              {{ section.settings.image | image_url: width: 1920 }} 1920w"
      sizes="100vw"
      alt="{{ section.settings.heading_line1 }} {{ section.settings.heading_line2 }}"
      loading="eager"
      fetchpriority="high">
  {%- else -%}
    <div class="hero-bg-placeholder"></div>
  {%- endif -%}

  <div class="hero-overlay"></div>

  <div class="hero-content">
    {%- if section.settings.eyebrow != blank -%}
      <div class="hero-eyebrow">
        <span class="hero-eyebrow-line"></span>
        <span class="hero-eyebrow-text">{{ section.settings.eyebrow }}</span>
        <span class="hero-eyebrow-line"></span>
      </div>
    {%- endif -%}

    <h1 class="hero-title">
      {{ section.settings.heading_line1 }}<br>
      <em>{{ section.settings.heading_line2 }}</em>
    </h1>

    <div class="hero-ornament">
      <span></span>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" width="10" height="10">
        <path d="M8 0l2 6h6l-5 3.5 2 6L8 12l-5 3.5 2-6L0 6h6z"/>
      </svg>
      <span></span>
    </div>

    {%- if section.settings.tagline != blank -%}
      <p class="hero-tagline">{{ section.settings.tagline }}</p>
    {%- endif -%}

    <div class="hero-actions">
      {%- if section.settings.cta1_label != blank -%}
        <a href="{{ section.settings.cta1_url | default: '/collections/all' }}" class="btn btn-hero-primary">
          {{ section.settings.cta1_label }}
        </a>
      {%- endif -%}
      {%- if section.settings.cta2_label != blank -%}
        <a href="{{ section.settings.cta2_url | default: '/collections' }}" class="btn btn-hero-outline">
          {{ section.settings.cta2_label }}
        </a>
      {%- endif -%}
    </div>

    <p class="hero-scroll-hint">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" width="16" height="16">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
      </svg>
      Scroll to discover
    </p>
  </div>

</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image",         "label": "Hero background image" },
    { "type": "text",         "id": "eyebrow",        "label": "Eyebrow text",              "default": "Welcome to" },
    { "type": "text",         "id": "heading_line1",  "label": "Heading line 1",            "default": "The Cosy" },
    { "type": "text",         "id": "heading_line2",  "label": "Heading line 2 (italic)",   "default": "Cairn" },
    { "type": "textarea",     "id": "tagline",        "label": "Tagline",                   "default": "Beautiful little finds for homes full of light and a little wonder" },
    { "type": "text",         "id": "cta1_label",     "label": "Button 1 label",            "default": "Shop Now" },
    { "type": "url",          "id": "cta1_url",       "label": "Button 1 URL" },
    { "type": "text",         "id": "cta2_label",     "label": "Button 2 label",            "default": "Explore Collections" },
    { "type": "url",          "id": "cta2_url",       "label": "Button 2 URL" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
