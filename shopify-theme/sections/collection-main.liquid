{%- liquid
  assign fallback_titles = 'Artisan Ceramic Vase,Woven Seagrass Basket,Linen Throw Pillow,Hand-Poured Lavender Candle,Dried Flower Bouquet,Chunky Knit Throw Blanket,Botanical Wall Art Print,Soy Wax Candle Trio' | split: ','
  assign fallback_prices = '£36.00,£24.50,£28.00,£18.00,£22.00,£58.00,£26.00,£42.00' | split: ','
  assign fallback_colors = '#b8bfc9,#c9b8a8,#c4bfb0,#b8c9a9,#d0c4b8,#ccc4b4,#c9b8a8,#b8c9a9' | split: ','
-%}

<!-- Collection Header -->
<div class="collection-header">
  <div class="container">
    {%- if collection.image -%}
      <div style="width:100%;max-height:320px;overflow:hidden;border-radius:var(--radius);margin-bottom:32px;">
        <img src="{{ collection.image | image_url: width: 1400 }}" alt="{{ collection.title | escape }}"
             style="width:100%;object-fit:cover;max-height:320px;" loading="eager">
      </div>
    {%- endif -%}
    <h1 class="section-title">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <p class="section-subtitle">{{ collection.description | strip_html }}</p>
    {%- endif -%}
    <div class="section-divider"></div>
  </div>
</div>

<div class="container" style="padding-bottom:80px;">
  {%- paginate collection.products by section.settings.products_per_page -%}

    {%- assign rendered = 0 -%}
    {%- if collection.products.size > 0 -%}
      <div class="collection-grid">
        {%- for product in collection.products -%}
          {%- render 'product-card', product: product -%}
          {%- assign rendered = rendered | plus: 1 -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="collection-grid">
        {%- for i in (0..7) -%}
          <div class="product-card">
            <div class="product-card-image">
              <div style="position:absolute;inset:0;background:linear-gradient(160deg,{{ fallback_colors[i] }},#f8f5f0);display:flex;align-items:center;justify-content:center;">
                <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="none" viewBox="0 0 24 24" stroke="rgba(92,92,82,0.25)" stroke-width="1"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              </div>
              <button class="product-card-quick" disabled>Add to Cart</button>
            </div>
            <div class="product-card-info">
              <h3 class="product-card-title">{{ fallback_titles[i] }}</h3>
              <div class="product-card-price"><span class="price">{{ fallback_prices[i] }}</span></div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if paginate.pages > 1 -%}
      <div style="text-align:center;padding:48px 0;">
        {{ paginate | default_pagination }}
      </div>
    {%- endif -%}

  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "range", "id": "products_per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 16 }
  ]
}
{% endschema %}
