<div class="collection-header">
  <div class="container">
    {%- if collection.image -%}
      <div style="width:100%;max-height:320px;overflow:hidden;border-radius:var(--radius);margin-bottom:32px;">
        <img src="{{ collection.image | image_url: width: 1400 }}" alt="{{ collection.title | escape }}"
             style="width:100%;object-fit:cover;max-height:320px;" loading="eager">
      </div>
    {%- endif -%}
    <h1 class="section-title">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <p class="section-subtitle">{{ collection.description | strip_html }}</p>
    {%- endif -%}
    <div class="section-divider"></div>
  </div>
</div>

<div class="container" style="padding-bottom:80px;">
  {%- paginate collection.products by section.settings.products_per_page -%}
    {%- if collection.products.size > 0 -%}
      <div class="collection-grid">
        {%- for product in collection.products -%}
          {%- render 'product-card', product: product -%}
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}
        <div style="text-align:center;padding:48px 0;">{{ paginate | default_pagination }}</div>
      {%- endif -%}
    {%- else -%}
      <div class="empty-state">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
        <h3>No products in this collection yet</h3>
        <p>Add products to this collection in your Shopify admin and they'll appear here automatically.</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn-outline">Browse All Products</a>
      </div>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "range", "id": "products_per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 16 }
  ]
}
{% endschema %}
