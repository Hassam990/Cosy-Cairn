<section class="trust-badges">
  <div class="container">
    {%- for i in (1..4) -%}
      {%- liquid
        assign title_key = 'badge_' | append: i | append: '_title'
        assign text_key  = 'badge_' | append: i | append: '_text'
        assign icon_key  = 'badge_' | append: i | append: '_icon'
        assign title_val = section.settings[title_key]
        assign text_val  = section.settings[text_key]
        assign icon_val  = section.settings[icon_key]
      -%}
      {%- if title_val != blank -%}
        <div class="trust-badge fade-in">
          <div class="trust-badge-icon">
            {%- if icon_val == 'plus' -%}
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
            {%- elsif icon_val == 'heart' -%}
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
            {%- elsif icon_val == 'leaf' -%}
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            {%- elsif icon_val == 'shield' -%}
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            {%- endif -%}
          </div>
          <div>
            <h4>{{ title_val }}</h4>
            <p>{{ text_val }}</p>
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Trust Badges",
  "settings": [
    { "type": "select", "id": "badge_1_icon",  "label": "Badge 1 icon",  "options": [{"value":"plus","label":"Plus"},{"value":"heart","label":"Heart"},{"value":"leaf","label":"Leaf"},{"value":"shield","label":"Shield"}], "default": "plus" },
    { "type": "text",   "id": "badge_1_title", "label": "Badge 1 title", "default": "Thoughtful Pieces" },
    { "type": "text",   "id": "badge_1_text",  "label": "Badge 1 text",  "default": "Lovingly chosen for your home and heart" },
    { "type": "select", "id": "badge_2_icon",  "label": "Badge 2 icon",  "options": [{"value":"plus","label":"Plus"},{"value":"heart","label":"Heart"},{"value":"leaf","label":"Leaf"},{"value":"shield","label":"Shield"}], "default": "heart" },
    { "type": "text",   "id": "badge_2_title", "label": "Badge 2 title", "default": "Small Shop" },
    { "type": "text",   "id": "badge_2_text",  "label": "Badge 2 text",  "default": "Thank you for supporting my dream" },
    { "type": "select", "id": "badge_3_icon",  "label": "Badge 3 icon",  "options": [{"value":"plus","label":"Plus"},{"value":"heart","label":"Heart"},{"value":"leaf","label":"Leaf"},{"value":"shield","label":"Shield"}], "default": "leaf" },
    { "type": "text",   "id": "badge_3_title", "label": "Badge 3 title", "default": "Eco Friendly" },
    { "type": "text",   "id": "badge_3_text",  "label": "Badge 3 text",  "default": "Sustainable packaging wherever possible" },
    { "type": "select", "id": "badge_4_icon",  "label": "Badge 4 icon",  "options": [{"value":"plus","label":"Plus"},{"value":"heart","label":"Heart"},{"value":"leaf","label":"Leaf"},{"value":"shield","label":"Shield"}], "default": "shield" },
    { "type": "text",   "id": "badge_4_title", "label": "Badge 4 title", "default": "Secure Checkout" },
    { "type": "text",   "id": "badge_4_text",  "label": "Badge 4 text",  "default": "Safe & secure payments you can trust" }
  ],
  "presets": [{ "name": "Trust Badges" }]
}
{% endschema %}
