{%- liquid
  assign real_cat_names   = 'Candles & Home Fragrance,Wellbeing & Self-Care,Home Décor & Accessories,Crystals & Spiritual Gifts,Gifts & Gift Sets,Garden & Outdoor Décor,Mugs & Drinkware,Jewellery,Ornaments & Figurines,Wall Art & Prints' | split: ','
  assign real_cat_handles = 'candles-home-fragrance,wellbeing-self-care,home-decor-accessories,crystals-spiritual-gifts,gifts-gift-sets,garden-outdoor-decor,mugs-drinkware,jewellery,ornaments-figurines,wall-art-prints' | split: ','
  assign fp_titles  = 'Serenity Self-Care Kit,Zen Shower Steamers,Buddha Feng Shui Set,White Crescent Moon Oil Burner,Love Healing Crystal Set,Set of 2 Witch Candles,Midnight Bloom Tulip Candle,Manifestation Crystal Set,Hedgehog Family Ornament,Crescent Moon Trinket Dish,Retro Gramophone Speaker,Golden Tarot Deck' | split: ','
  assign fp_prices  = '£22.00,£8.00,£39.00,£10.99,£9.99,£12.99,£9.99,£16.99,£12.99,£7.99,£29.00,£14.00' | split: ','
  assign fp_compare = ',,,,,,,,,,,,' | split: ','
  assign fp_badges  = 'Best Seller,New,Best Seller,,New,New,New,,New,,,' | split: ','
  assign fp_types   = 'Wellbeing & Self-Care,Wellbeing,Home Décor,Candles,Crystals,Candles,Candles,Crystals,Ornaments,Home Décor,Home Décor,Crystals' | split: ','
  assign fp_colors  = '#c9b8a8,#b8c9a9,#b8bfc9,#c4bfb0,#c0786a,#3d3d35,#3d3d35,#b8c9a9,#d4c4b0,#3d3d35,#ccc4b4,#d4c4b0' | split: ','
-%}

<!-- Page Header -->
<section class="page-header">
  <div class="container">
    <h1>{{ section.settings.title }}</h1>
    <p>{{ section.settings.subtitle }}</p>
  </div>
</section>

<section class="section" style="padding-top:48px;">
  <div class="container">
    <div class="shop-layout">

      <!-- Sidebar -->
      <aside class="shop-sidebar">
        <div class="filter-group">
          <h3>Categories</h3>
          <div class="filter-options">
            {%- for i in (0..9) -%}
              <label>
                <input type="checkbox" value="{{ real_cat_handles[i] }}" class="filter-check" onchange="filterProducts(this)">
                {{ real_cat_names[i] }}
              </label>
            {%- endfor -%}
          </div>
        </div>

        <div class="filter-group">
          <h3>Collections</h3>
          <div class="filter-options">
            {%- assign col_count = 0 -%}
            {%- for col in collections -%}
              {%- unless col.handle == 'frontpage' or col.handle == 'all' -%}
                <label>
                  <input type="checkbox" value="{{ col.handle }}" class="filter-check" onchange="filterProducts(this)">
                  {{ col.title }}
                </label>
                {%- assign col_count = col_count | plus: 1 -%}
                {%- if col_count >= 8 -%}{%- break -%}{%- endif -%}
              {%- endunless -%}
            {%- endfor -%}
            {%- if col_count == 0 -%}
              {%- for i in (0..4) -%}
                <label>
                  <input type="checkbox" value="{{ real_cat_handles[i] }}" class="filter-check">
                  {{ real_cat_names[i] }}
                </label>
              {%- endfor -%}
            {%- endif -%}
          </div>
        </div>

        <div class="filter-group" style="text-align:center;">
          <p style="color:var(--text-light);font-style:italic;font-size:0.9rem;line-height:1.7;">
            Need help finding something?<br>
            <a href="/pages/contact" style="color:var(--sage-dark);text-decoration:underline;">Get in touch</a>
          </p>
        </div>
      </aside>

      <!-- Products -->
      <div class="shop-main-content">
        <div class="shop-toolbar">
          {%- assign total = collections.all.products_count | default: 50 -%}
          <p class="shop-result-count" id="product-count">{{ total }} product{% if total != 1 %}s{% endif %}</p>
          <form method="get" action="{{ request.path }}">
            <select name="sort_by" class="sort-select" onchange="this.form.submit()" aria-label="Sort products">
              <option value="manual" {% if collection.sort_by == 'manual' %}selected{% endif %}>Sort by: Featured</option>
              <option value="price-ascending"  {% if collection.sort_by == 'price-ascending'  %}selected{% endif %}>Price: Low to High</option>
              <option value="price-descending" {% if collection.sort_by == 'price-descending' %}selected{% endif %}>Price: High to Low</option>
              <option value="title-ascending"  {% if collection.sort_by == 'title-ascending'  %}selected{% endif %}>Name: A to Z</option>
              <option value="created-descending" {% if collection.sort_by == 'created-descending' %}selected{% endif %}>Newest First</option>
            </select>
          </form>
        </div>

        <div class="product-grid shop-grid" id="shop-product-grid">
          {%- assign rendered = 0 -%}
          {%- for product in collections.all.products -%}
            {%- render 'product-card', product: product -%}
            {%- assign rendered = rendered | plus: 1 -%}
          {%- endfor -%}

          {%- comment -%}Placeholder cards if fewer than 8 real products loaded{%- endcomment -%}
          {%- if rendered < 8 -%}
            {%- assign needed = 8 | minus: rendered -%}
            {%- for i in (1..needed) -%}
              {%- assign idx   = rendered | plus: forloop.index0 -%}
              {%- assign pt    = fp_titles[idx]  | default: 'Cosy Home Piece' -%}
              {%- assign pp    = fp_prices[idx]  | default: '£12.00' -%}
              {%- assign pb    = fp_badges[idx] -%}
              {%- assign ptype = fp_types[idx]   | default: 'Home Décor' -%}
              {%- assign pclr  = fp_colors[idx]  | default: '#e5ddd3' -%}
              <div class="product-card">
                <div class="product-card-image">
                  <div style="position:absolute;inset:0;background:linear-gradient(160deg,{{ pclr }},#f8f5f0);display:flex;align-items:center;justify-content:center;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="44" height="44" fill="none" viewBox="0 0 24 24" stroke="rgba(255,255,255,0.35)" stroke-width="1">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                  </div>
                  {%- if pb != blank and pb != '' -%}
                    <span class="product-badge{% if pb == 'Sale' %} sale{% elsif pb == 'New' %} new{% endif %}">{{ pb }}</span>
                  {%- endif -%}
                  <div class="product-card-quick" style="cursor:default;">Add to Cart</div>
                </div>
                <div class="product-card-info">
                  <p style="font-size:0.68rem;text-transform:uppercase;letter-spacing:1.5px;color:var(--text-light);margin-bottom:6px;">{{ ptype }}</p>
                  <h3 class="product-card-title">{{ pt }}</h3>
                  <div class="product-card-price"><span class="price">{{ pp }}</span></div>
                </div>
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop",
  "settings": [
    { "type": "text", "id": "title",    "label": "Page title",    "default": "Shop" },
    { "type": "text", "id": "subtitle", "label": "Page subtitle", "default": "Thoughtfully chosen pieces for your cosy home" }
  ],
  "presets": [{ "name": "Shop" }]
}
{% endschema %}
