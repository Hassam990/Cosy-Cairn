<div class="page-header">
  <div class="container"><h1>Create Account</h1></div>
</div>
<div class="container">
  <div style="max-width:480px;margin:64px auto;">
    {%- form 'create_customer' -%}
      {%- if form.errors -%}
        <p style="color:#c0786a;margin-bottom:16px;font-size:0.9rem;">{{ form.errors | default_errors }}</p>
      {%- endif -%}
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:20px;">
        <div>
          <label style="font-size:0.8rem;letter-spacing:1px;text-transform:uppercase;display:block;margin-bottom:8px;">First Name</label>
          <input type="text" name="customer[first_name]" autocomplete="given-name" style="width:100%;padding:12px 16px;border:1.5px solid var(--beige);border-radius:var(--radius-sm);background:var(--cream);font-family:inherit;font-size:1rem;">
        </div>
        <div>
          <label style="font-size:0.8rem;letter-spacing:1px;text-transform:uppercase;display:block;margin-bottom:8px;">Last Name</label>
          <input type="text" name="customer[last_name]" autocomplete="family-name" style="width:100%;padding:12px 16px;border:1.5px solid var(--beige);border-radius:var(--radius-sm);background:var(--cream);font-family:inherit;font-size:1rem;">
        </div>
      </div>
      <div style="margin-bottom:20px;">
        <label style="font-size:0.8rem;letter-spacing:1px;text-transform:uppercase;display:block;margin-bottom:8px;">Email</label>
        <input type="email" name="customer[email]" autocomplete="email" style="width:100%;padding:12px 16px;border:1.5px solid var(--beige);border-radius:var(--radius-sm);background:var(--cream);font-family:inherit;font-size:1rem;">
      </div>
      <div style="margin-bottom:28px;">
        <label style="font-size:0.8rem;letter-spacing:1px;text-transform:uppercase;display:block;margin-bottom:8px;">Password</label>
        <input type="password" name="customer[password]" autocomplete="new-password" style="width:100%;padding:12px 16px;border:1.5px solid var(--beige);border-radius:var(--radius-sm);background:var(--cream);font-family:inherit;font-size:1rem;">
      </div>
      <button type="submit" class="btn btn-primary btn-full">Create Account</button>
      <p style="text-align:center;margin-top:20px;font-size:0.9rem;color:var(--text-light);">
        Already have an account? <a href="{{ routes.account_login_url }}" style="color:var(--sage-dark);">Log in</a>
      </p>
    {%- endform -%}
  </div>
</div>

{% schema %}
{ "name": "Register", "settings": [] }
{% endschema %}
