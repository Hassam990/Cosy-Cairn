<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">

      <!-- Brand column -->
      <div class="footer-brand">
        <h3 class="footer-brand-name">{{ shop.name }}</h3>
        <p>{{ section.settings.brand_text }}</p>
        <div class="footer-social">
          {%- if section.settings.instagram != blank -%}
            <a href="{{ section.settings.instagram }}" aria-label="Instagram" target="_blank" rel="noopener">
          {%- else -%}
            <a href="#" aria-label="Instagram">
          {%- endif -%}
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </a>
          {%- if section.settings.pinterest != blank -%}
            <a href="{{ section.settings.pinterest }}" aria-label="Pinterest" target="_blank" rel="noopener">
          {%- else -%}
            <a href="#" aria-label="Pinterest">
          {%- endif -%}
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M8 12c0-2.76 1.79-5 4-5s4 2.24 4 5c0 2.76-1.79 5-4 5"/></svg>
          </a>
          {%- if section.settings.facebook != blank -%}
            <a href="{{ section.settings.facebook }}" aria-label="Facebook" target="_blank" rel="noopener">
          {%- else -%}
            <a href="#" aria-label="Facebook">
          {%- endif -%}
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>
          </a>
          {%- if section.settings.tiktok != blank -%}
            <a href="{{ section.settings.tiktok }}" aria-label="TikTok" target="_blank" rel="noopener">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M9 12a4 4 0 104 4V4a5 5 0 005 5"/></svg>
            </a>
          {%- endif -%}
        </div>
      </div>

      <!-- Column 1 -->
      <div class="footer-column">
        <h4>{{ section.settings.col_1_title }}</h4>
        <ul>
          {%- assign col1 = linklists[section.settings.col_1_menu].links -%}
          {%- if col1.size > 0 -%}
            {%- for link in col1 -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          {%- else -%}
            <li><a href="{{ routes.all_products_collection_url }}">All Products</a></li>
            <li><a href="/collections/new-in">New In</a></li>
            <li><a href="/collections">Collections</a></li>
            <li><a href="/collections/gifts-gift-sets">Gifts</a></li>
          {%- endif -%}
        </ul>
      </div>

      <!-- Column 2 -->
      <div class="footer-column">
        <h4>{{ section.settings.col_2_title }}</h4>
        <ul>
          {%- assign col2 = linklists[section.settings.col_2_menu].links -%}
          {%- if col2.size > 0 -%}
            {%- for link in col2 -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          {%- else -%}
            <li><a href="/pages/contact">Contact Us</a></li>
            <li><a href="{{ shop.url }}/policies/shipping-policy">Shipping &amp; Returns</a></li>
            <li><a href="/pages/faq">FAQ</a></li>
            <li><a href="{{ shop.url }}/policies/privacy-policy">Privacy Policy</a></li>
          {%- endif -%}
        </ul>
      </div>

      <!-- Column 3 -->
      <div class="footer-column">
        <h4>{{ section.settings.col_3_title }}</h4>
        <ul>
          {%- assign col3 = linklists[section.settings.col_3_menu].links -%}
          {%- if col3.size > 0 -%}
            {%- for link in col3 -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          {%- else -%}
            <li><a href="/pages/about">Our Story</a></li>
            <li><a href="/pages/about">Sustainability</a></li>
            <li><a href="/pages/contact">Stockists</a></li>
          {%- endif -%}
        </ul>
      </div>

    </div>

    <div class="footer-bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.copyright_text }}</p>
      <p>{{ section.settings.footer_note }}</p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "textarea",
      "id": "brand_text",
      "label": "Brand description",
      "default": "Beautiful little finds for homes full of light and a little wonder. Thoughtfully chosen, lovingly packed, and sent with care."
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright text",
      "default": "All rights reserved."
    },
    {
      "type": "text",
      "id": "footer_note",
      "label": "Footer note",
      "default": "Designed with love for cosy homes."
    },
    {
      "type": "header",
      "content": "Social Media Links"
    },
    {
      "type": "url",
      "id": "instagram",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "pinterest",
      "label": "Pinterest URL"
    },
    {
      "type": "url",
      "id": "facebook",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "tiktok",
      "label": "TikTok URL"
    },
    {
      "type": "header",
      "content": "Column 1 — Shop"
    },
    {
      "type": "text",
      "id": "col_1_title",
      "label": "Column 1 heading",
      "default": "Shop"
    },
    {
      "type": "link_list",
      "id": "col_1_menu",
      "label": "Column 1 menu",
      "default": "footer-shop",
      "info": "Create a menu called 'footer-shop' in Navigation"
    },
    {
      "type": "header",
      "content": "Column 2 — Help"
    },
    {
      "type": "text",
      "id": "col_2_title",
      "label": "Column 2 heading",
      "default": "Help"
    },
    {
      "type": "link_list",
      "id": "col_2_menu",
      "label": "Column 2 menu",
      "default": "footer-help",
      "info": "Create a menu called 'footer-help' in Navigation"
    },
    {
      "type": "header",
      "content": "Column 3 — About"
    },
    {
      "type": "text",
      "id": "col_3_title",
      "label": "Column 3 heading",
      "default": "About"
    },
    {
      "type": "link_list",
      "id": "col_3_menu",
      "label": "Column 3 menu",
      "default": "footer-about",
      "info": "Create a menu called 'footer-about' in Navigation"
    }
  ]
}
{% endschema %}
