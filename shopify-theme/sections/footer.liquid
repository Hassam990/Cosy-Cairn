<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">

      <!-- Brand column -->
      <div class="footer-brand">
        <h3 class="footer-brand-name">{{ shop.name }}</h3>
        <p>{{ section.settings.brand_text }}</p>
        <div class="footer-social">
          {%- if settings.social_instagram != blank -%}
            <a href="{{ settings.social_instagram }}" aria-label="Instagram" target="_blank" rel="noopener">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_pinterest != blank -%}
            <a href="{{ settings.social_pinterest }}" aria-label="Pinterest" target="_blank" rel="noopener">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M8 12c0-2.76 1.79-5 4-5s4 2.24 4 5c0 2.76-1.79 5-4 5"/></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_facebook != blank -%}
            <a href="{{ settings.social_facebook }}" aria-label="Facebook" target="_blank" rel="noopener">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>
            </a>
          {%- endif -%}
        </div>
      </div>

      <!-- Link columns -->
      {%- for i in (1..3) -%}
        {%- liquid
          assign col_title_key = 'col_' | append: i | append: '_title'
          assign col_menu_key  = 'col_' | append: i | append: '_menu'
          assign col_title     = section.settings[col_title_key]
          assign col_menu      = section.settings[col_menu_key]
        -%}
        {%- if col_title != blank -%}
          <div class="footer-column">
            <h4>{{ col_title }}</h4>
            {%- if col_menu != blank -%}
              <ul>
                {%- for link in linklists[col_menu].links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}

    </div>

    <div class="footer-bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>
      <p>{{ section.settings.footer_note }}</p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "textarea",  "id": "brand_text",  "label": "Brand description", "default": "Beautiful little finds for homes full of light and a little wonder. Thoughtfully chosen, lovingly packed, and sent with care." },
    { "type": "text",      "id": "footer_note", "label": "Footer note",       "default": "Designed with love for cosy homes." },
    { "type": "text",      "id": "col_1_title", "label": "Column 1 title",    "default": "Shop" },
    { "type": "link_list", "id": "col_1_menu",  "label": "Column 1 menu",     "default": "footer-shop" },
    { "type": "text",      "id": "col_2_title", "label": "Column 2 title",    "default": "Help" },
    { "type": "link_list", "id": "col_2_menu",  "label": "Column 2 menu",     "default": "footer-help" },
    { "type": "text",      "id": "col_3_title", "label": "Column 3 title",    "default": "About" },
    { "type": "link_list", "id": "col_3_menu",  "label": "Column 3 menu",     "default": "footer-about" }
  ]
}
{% endschema %}
